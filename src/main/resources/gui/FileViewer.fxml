<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.FileViewerController">
   <children>
      <TableView fx:id="tableView" layoutX="188.0" prefHeight="401.0" prefWidth="412.0">
        <columns>
          <TableColumn fx:id="pidColumn" prefWidth="75.0" text="PID" />
          <TableColumn fx:id="productColumn" prefWidth="75.0" text="Product" />
          <TableColumn fx:id="profitColumn" prefWidth="75.0" text="Profit" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <GridPane alignment="CENTER" layoutX="2.0" layoutY="150.0" prefHeight="40.0" prefWidth="188.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Label alignment="CENTER" prefHeight="40.0" prefWidth="188.0" text="請輸入想刪除的PID編號" />
         </children>
      </GridPane>
      <TextField fx:id="delfield" alignment="CENTER" layoutX="31.0" layoutY="186.0" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="30.0" prefWidth="130.0" />
      <Button onAction = "#hitdelbutton" layoutX="69.0" layoutY="222.0" mnemonicParsing="false" text="Delete" />
   </children>
</AnchorPane>
