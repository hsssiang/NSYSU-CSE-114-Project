<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.MainPageController">
   <children>
      <StackPane prefHeight="150.0" prefWidth="200.0">
         <children>
             <ImageView fx:id="AlogorithmAnimation" fitHeight="700.0" fitWidth="1920.0" nodeOrientation="INHERIT" pickOnBounds="true" preserveRatio="true">
            </ImageView>
         </children>
      </StackPane>
         <GridPane prefHeight="150.0" prefWidth="1920.0">
             <columnConstraints>
                 <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="100.0" />
                 <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="100.0" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="100.0" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="100.0" />
             </columnConstraints>
             <rowConstraints>
                 <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="ALWAYS" />
             </rowConstraints>
             <children>
                 <Button mnemonicParsing="false" onAction="#InsertDataButtonClick" prefHeight="247.0" prefWidth="576.0" text="Insert Data">
               <font>
                  <Font name="Chalkboard" size="36.0" />
               </font>
            </Button>
                 <Button mnemonicParsing="false" onAction="#FileViewerButtonClick" prefHeight="205.0" prefWidth="606.0" text="Display Data" GridPane.columnIndex="1">
               <font>
                  <Font name="Chalkboard" size="36.0" />
               </font>
            </Button>
                 <Button mnemonicParsing="false" onAction="#AlgorithmButtonClick" prefHeight="182.0" prefWidth="652.0" text="Execute" GridPane.columnIndex="2">
               <font>
                  <Font name="Chalkboard" size="36.0" />
               </font>
            </Button>
                 <Button mnemonicParsing="false" onAction="#AnmationButtonClick" prefHeight="184.0" prefWidth="597.0" text="Animation" textAlignment="CENTER" GridPane.columnIndex="3">
                     <font>
                         <Font name="Chalkboard" size="36.0" />
                     </font>
                 </Button>
             </children>
         </GridPane>
   </children>
</VBox>
